# Normalise text, keep binary assets byte-identical.
* text=auto eol=lf
*.py text eol=lf
*.ino text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.pdf binary
*.hex binary
